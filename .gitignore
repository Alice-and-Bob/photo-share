# 构建产物（gradle 包装器与源码除外）
**/build/
.kotlin/
/.idea/

# 测试 / 调试产生的二进制与 UI 快照（非源码，不入库）
# 脚本现已移入 scripts/ 等子目录，故去掉根目录限定，覆盖任意位置的同名产物
shot_*.png
1.png
2.png
ui_*.xml

# Python 脚本缓存（scripts/ 下的验证脚本运行时产生）
__pycache__/
*.pyc

# 发布产物：APK/AAB 不入库（二进制会让仓库体积随每次构建线性膨胀）
# 分发请走 GitHub Release 附件 / 制品库，或按需启用 Git LFS
*.apk
*.aab
*.apks

# 清理用的临时回收目录（存放从根目录移出的调试产物，不入库）
/.cleanup_trash/

# 代理 / 工作区内部数据（非项目源码）
/.workbuddy/
*.log
